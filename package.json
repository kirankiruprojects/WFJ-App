{
  "name": "workforce-junction-app",
  "version": "1.1.0",
  "description": "Workforce Junction - CRF & Client Termination Checklist workspace (Express + SQLite)",
  "main": "main.js",
  "scripts": {
    "start": "node --max-old-space-size=256 server.js",
    "electron": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.workforcejunction.app",
    "productName": "Workforce Junction",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "schema.js",
      "index.html",
      "public/**/*",
      "node_modules/**/*",
      "data.db"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/images/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "multer": "^2.2.0",
    "xlsx": "^0.18.5",
    "xlsx-populate": "^1.21.0"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}